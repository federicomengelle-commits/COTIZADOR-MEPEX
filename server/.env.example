# MEPEX Cotizador — variables de entorno del backend
# Copiá este archivo a `.env` y completá los valores reales.
# NO commitear `.env` (está gitignored).

# ── Supabase ──
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── Backend ──
PORT=3001

# ── IA (Claude) — sanata comercial del PDF + brief→cotización ──
# IMPORTANTE: la API se factura por token, APARTE de ChatGPT Plus / Claude Pro
# (esas suscripciones NO incluyen API). Creá créditos en console.anthropic.com.
# Si esta variable falta, las features de IA quedan deshabilitadas (el resto del
# cotizador funciona igual).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Modelo a usar (default: claude-haiku-4-5 — el más barato apto para texto corto)
ANTHROPIC_MODEL=claude-haiku-4-5
